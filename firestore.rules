rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인한 본인만 자기 할 일을 읽고 쓸 수 있어요. 그 외 모든 접근은 막혀 있어요.
    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['text', 'date', 'done', 'order'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.done is bool
        && request.resource.data.order is number;
    }
    // 노트: 로그인한 본인만 읽고 쓰기 (문서는 note 하나, 최대 2만 자)
    match /users/{uid}/meta/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && docId == 'note'
        && request.resource.data.keys().hasOnly(['text', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 20000
        && request.resource.data.updatedAt is number;
    }
  }
}
